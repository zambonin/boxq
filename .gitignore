.venv/
.cache/
__pycache__/
.pytest_cache/
*.egg-info/
/build/
dist/
output/
*.qnf
*.qdd

# These are source headers, even when global ignores match build/.
!boxq/_native/build/
!boxq/_native/build/*.hpp

# Redistributable, attributed MISTY1 inputs and provenance are package assets.
!boxq/data/
!boxq/data/misty1.json
!boxq/data/misty1-provenance.json

# The experiment interpreter is pinned even when global ignores hide it.
!.python-version
